{
  "$id": "h001_open3dsg_failure_analysis_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "type": "string"
    },
    "audit_hooks": {
      "additionalProperties": false,
      "properties": {
        "artifact_paths": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": "object"
        },
        "needs_visual_audit": {
          "type": "boolean"
        },
        "review_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "needs_visual_audit",
        "artifact_paths"
      ],
      "type": "object"
    },
    "cross_source": {
      "additionalProperties": false,
      "properties": {
        "vlsat_prediction_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "vlsat_same_pair_status": {
          "enum": [
            "not_joined",
            "same_failure",
            "open3dsg_specific_failure",
            "vlsat_specific_failure",
            "both_correct",
            "pair_not_in_vlsat_source",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "vlsat_same_pair_status"
      ],
      "type": "object"
    },
    "failure_taxonomy": {
      "additionalProperties": false,
      "properties": {
        "assignment_rule": {
          "type": "string"
        },
        "claim_use": {
          "enum": [
            "include_metric",
            "positive_evidence",
            "main_h001_failure",
            "audit_queue",
            "caveat_only",
            "exclude_until_fixed",
            "exclude_from_h001_family_claim"
          ],
          "type": "string"
        },
        "primary_category": {
          "enum": [
            "true_positive_supported",
            "semantic_false_positive",
            "geometry_contradiction",
            "semantic_and_geometry_failure",
            "plausible_unlabeled",
            "predicate_family_ambiguity",
            "object_pair_mismatch",
            "insufficient_geometry_evidence",
            "preprocessing_or_filtering_limitation",
            "unsupported_family_out_of_scope",
            "rank_only_failure",
            "model_score_calibration_failure",
            "adapter_or_identity_error",
            "unknown_needs_audit"
          ],
          "type": "string"
        },
        "secondary_categories": {
          "items": {
            "enum": [
              "true_positive_supported",
              "semantic_false_positive",
              "geometry_contradiction",
              "semantic_and_geometry_failure",
              "plausible_unlabeled",
              "predicate_family_ambiguity",
              "object_pair_mismatch",
              "insufficient_geometry_evidence",
              "preprocessing_or_filtering_limitation",
              "unsupported_family_out_of_scope",
              "rank_only_failure",
              "model_score_calibration_failure",
              "adapter_or_identity_error",
              "unknown_needs_audit"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "severity": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        }
      },
      "required": [
        "primary_category",
        "secondary_categories",
        "severity",
        "assignment_rule",
        "claim_use"
      ],
      "type": "object"
    },
    "geometry": {
      "additionalProperties": false,
      "properties": {
        "consistency_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "geometry_available": {
          "type": "boolean"
        },
        "geometry_checkable": {
          "type": "boolean"
        },
        "geometry_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "p_geom_valid": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "verification_status": {
          "enum": [
            "satisfied",
            "violated",
            "uncertain",
            "unsupported",
            "missing_geometry",
            "join_error"
          ],
          "type": "string"
        }
      },
      "required": [
        "geometry_available",
        "geometry_checkable",
        "verification_status",
        "p_geom_valid",
        "consistency_score",
        "reason_codes"
      ],
      "type": "object"
    },
    "ground_truth": {
      "additionalProperties": false,
      "properties": {
        "in_h001_denominator": {
          "type": "boolean"
        },
        "match_status": {
          "enum": [
            "exact_match",
            "family_match",
            "pair_has_other_predicate",
            "no_gt_for_pair",
            "predicate_unlabeled_possible",
            "not_joined"
          ],
          "type": "string"
        },
        "matched_gt_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "matched_predicates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "match_status",
        "matched_gt_ids"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_locked_before_metric_inspection": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_locked_before_metric_inspection",
        "created_by",
        "inputs"
      ],
      "type": "object"
    },
    "quality_flags": {
      "additionalProperties": false,
      "properties": {
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "heldout_leakage_guard": {
          "type": "boolean"
        },
        "identity_preserved": {
          "type": "boolean"
        },
        "metric_eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "heldout_leakage_guard",
        "identity_preserved",
        "metric_eligible"
      ],
      "type": "object"
    },
    "record_type": {
      "enum": [
        "open3dsg_failure_analysis",
        "vlsat_failure_analysis"
      ],
      "type": "string"
    },
    "rerank_effect": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "delta_rank": {
          "type": [
            "integer",
            "null"
          ]
        },
        "geometry_rank": {
          "type": [
            "integer",
            "null"
          ]
        },
        "semantic_rank": {
          "type": [
            "integer",
            "null"
          ]
        },
        "topk_transition": {
          "enum": [
            "promoted_into_top50",
            "promoted_into_top100",
            "demoted_out_of_top50",
            "demoted_out_of_top100",
            "stayed_in_topk",
            "unchanged_outside_topk",
            "filtered_by_rule",
            "not_computed"
          ],
          "type": "string"
        }
      },
      "required": [
        "semantic_rank",
        "geometry_rank",
        "delta_rank",
        "topk_transition"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "h001_open3dsg_failure_analysis_v1"
    },
    "source_prediction": {
      "additionalProperties": false,
      "properties": {
        "baseline_name": {
          "enum": [
            "open3dsg_ov",
            "vlsat_closed_set"
          ],
          "type": "string"
        },
        "baseline_run_id": {
          "type": "string"
        },
        "object_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "object_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "predicate_family": {
          "type": "string"
        },
        "predicate_label": {
          "type": "string"
        },
        "predicate_rank_for_pair": {
          "type": [
            "integer",
            "null"
          ]
        },
        "prediction_id": {
          "type": "string"
        },
        "scan_id": {
          "type": "string"
        },
        "semantic_rank_in_subgraph": {
          "type": [
            "integer",
            "null"
          ]
        },
        "semantic_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "subgraph_id": {
          "type": "string"
        },
        "subject_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "subject_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "topk_membership": {
          "additionalProperties": false,
          "properties": {
            "top100": {
              "type": "boolean"
            },
            "top50": {
              "type": "boolean"
            }
          },
          "required": [
            "top50",
            "top100"
          ],
          "type": "object"
        }
      },
      "required": [
        "prediction_id",
        "baseline_name",
        "baseline_run_id",
        "scan_id",
        "subgraph_id",
        "subject_id",
        "object_id",
        "predicate_label",
        "predicate_family",
        "semantic_score",
        "semantic_rank_in_subgraph",
        "predicate_rank_for_pair",
        "topk_membership"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "analysis_id",
    "source_prediction",
    "ground_truth",
    "geometry",
    "rerank_effect",
    "failure_taxonomy",
    "cross_source",
    "audit_hooks",
    "quality_flags",
    "provenance"
  ],
  "title": "H001 source failure-analysis row",
  "type": "object"
}
