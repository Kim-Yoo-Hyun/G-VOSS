{
  "$id": "h001_qwen_vl_input_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_predicates": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "crop_paths": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "frame_id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "object_bbox_xyxy": {
            "items": {
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": [
              "array",
              "null"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "pair",
              "subject",
              "object",
              "context",
              "auxiliary"
            ],
            "type": "string"
          },
          "subject_bbox_xyxy": {
            "items": {
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": [
              "array",
              "null"
            ]
          },
          "view_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "role",
          "view_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "geometry_summary": {
      "type": [
        "object",
        "null"
      ]
    },
    "object_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "object_label": {
      "minLength": 1,
      "type": "string"
    },
    "predicate_family": {
      "enum": [
        "proximity",
        "relative_vertical",
        "support_contact"
      ],
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "scan_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "h001_qwen_vl_input_v2"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "held_out",
        "pilot",
        "smoke"
      ],
      "type": "string"
    },
    "subgraph_id": {
      "minLength": 1,
      "type": "string"
    },
    "subject_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "subject_label": {
      "minLength": 1,
      "type": "string"
    },
    "view_set_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "scan_id",
    "subgraph_id",
    "split",
    "subject_id",
    "object_id",
    "subject_label",
    "object_label",
    "predicate_family",
    "candidate_predicates",
    "view_set_id",
    "crop_paths"
  ],
  "title": "H001 Qwen-VL input record",
  "type": "object"
}
